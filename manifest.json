{
  "manifest_version": 3,
  "name": "CPlug - Integração de Códigos PDV",
  "version": "2.3.6",
  "description": "Exporta chaves do ConnectPlug e aplica os códigos PDV no Alloy/UP ou iFood com revisão prévia.",
  "author": "math7x",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://connectplug.com.br/*",
    "https://parceiros.online.uptecnologias.app.br/*",
    "https://portal.ifood.com.br/*"
  ],
  "action": {
    "default_title": "CPlug - Integração de Códigos PDV",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connectplug.com.br/sistema/produtos*"
      ],
      "js": [
        "xlsx-exporter.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://parceiros.online.uptecnologias.app.br/catalogo*",
        "https://parceiros.online.uptecnologias.app.br/edicao-complementos*"
      ],
      "js": [
        "up-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.ifood.com.br/menu/list/pdv*"
      ],
      "js": [
        "ifood-content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
